NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000

# Plaid API credentials (server-side only)
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret
PLAID_ENV=sandbox
# Required when PLAID_ENV=production (must be HTTPS and registered in Plaid Dashboard).
# Also recommended for OAuth institutions in any environment:
# PLAID_REDIRECT_URI=http://localhost:3000/

# At least 32 characters. Used to sign the session cookie.
SESSION_SIGNING_SECRET=replace_with_long_random_secret_value

# Must be exactly 32 bytes when base64-decoded.
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=replace_with_base64_32_byte_key

# Generate with:
# npm run hash-password -- "your-long-password"
ADMIN_PASSWORD_HASH=scrypt$32768$8$1$replace_salt$replace_hash

# Session expiration for in-memory data.
SESSION_TTL_MINUTES=60
